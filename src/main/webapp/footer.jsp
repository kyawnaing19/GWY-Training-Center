<!DOCTYPE html>
<html>
<head>
<style>
/* Style for the footer */
footer {
    background-color: #f0f0f0;
    padding: 20px;
    text-align: center;
}

/* Style for the footer content */
#footer {
  font-size: 14px;
  background: #0c0116;
}

#footer .footer-bottom {
  padding-top: 30px;
  padding-bottom: 30px;
  color: #fff;
}

#footer .copyright {
  float: left;
}

#footer .credits {
  float: right;
  font-size: 13px;
}



@media (max-width: 768px) {
  #footer .footer-bottom {
    padding-top: 20px;
    padding-bottom: 20px;
  }
  
  #footer .copyright,
  #footer .credits {
    text-align: center;
    float: none;
  }
  
  #footer .credits {
    padding-top: 4px;
  }
}

</style>
<meta charset="ISO-8859-1">
